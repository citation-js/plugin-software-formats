{
  "name": "root",
  "private": true,
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@citation-js/core": "^0.8.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-vuln-regex-detector": "^1.0.4",
    "lerna": "^10.0.1",
    "mocha": "^12.0.0",
